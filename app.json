{
  "expo": {
    "name": "The Praying App",
    "slug": "stillhour-prayer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.connexional.stillhour",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.connexional.stillhour",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#193C33"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "stillhour",
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-sqlite",
      "expo-font"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a47226c6-5c20-4282-97ee-8fc373a47248"
      }
    },
    "owner": "martin_osei"
  }
}
